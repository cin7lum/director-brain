# 模型 API（观察服务 / LLM）
OLLAMA_BASE_URL=http://localhost:11434
# Project manifests may explicitly select local_vlm_shadow_v1. That path is
# loopback-only and requires pins for the installed Ollama build and model blob.
PROJECT_LOCAL_VLM_MODEL=qwen3-vl:8b
PROJECT_LOCAL_VLM_DIGEST=
PROJECT_LOCAL_VLM_RUNTIME_VERSION=
# Formal project Reasoner selection requires an exact local Ollama model digest
# and runtime version. SHADOW comparisons may run without these pins and remain
# explicitly unbound in their provenance.
PROJECT_LOCAL_REASONER_MODEL_DIGEST=
PROJECT_LOCAL_REASONER_RUNTIME_VERSION=
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 文本 LLM
TEXT_LLM_PROVIDER=zhipu  # ollama | zhipu
TEXT_LLM_MODEL=glm-4-flash

# VLM
VLM_PROVIDER=zhipu  # ollama | zhipu
VLM_MODEL=glm-4.6v-flash

# 存储
STORAGE_BACKEND=sqlite  # sqlite | postgresql
SQLITE_PATH=./data/director_brain.db

# P1 项目素材入口：留空时项目素材接口保持关闭。
# 必须同时配置强随机 Bearer token；本机请求仍需显式凭证。
DIRECTOR_BRAIN_PROJECT_API_TOKEN=
# 设为明确授权供本机 02 使用的媒体根目录；路径外、LAN 客户端和缺少授权声明的素材均拒绝。
DIRECTOR_BRAIN_ALLOWED_MEDIA_ROOT=

# 日志
LOG_LEVEL=INFO

# ASR 设备策略（P2-a）：auto = 先试 GPU(cuda/float16)，缺 CUDA 运行库自动回退 CPU
# 启用 GPU 需 NVIDIA 官方运行库（示例：pip install nvidia-cublas-cu12 nvidia-cudnn-cu12，
# 并把包内 DLL 目录加入 PATH）；不装也能跑（CPU int8）。
ASR_DEVICE=auto
# local_asr_shadow_v1 项目分析只接受此绝对本地模型目录；模型树摘要和运行依赖版本
# 自动进入 Context/cache identity。不得填写远程模型别名，避免触发隐式下载。
ASR_MODEL_PATH=

# 火山方舟（豆包）—— 阶段 7 模型准入 / 链 B 语义推理
# key 只放本地 .env（已被 .gitignore 排除），绝不入库
# ARK_MODEL 必须钉扎快照 ID（带日期后缀），禁止用别名——别名会随上游
# 静默更新漂移，破坏冻结基准的可复现性。当前准入快照见
# evidence/DIRECTOR_BRAIN_MODEL_ADMISSION/MODEL_ADMISSION.md
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-lite-260915

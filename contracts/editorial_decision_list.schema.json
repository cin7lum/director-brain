          "type": "string"
        },
        "title": "Decision Refs",
        "type": "array"
      },
      "audio_refs": {
        "items": {
          "type": "string"
        },
        "title": "Audio Refs",
        "type": "array"
      },
      "overlay_refs": {
        "items": {
          "type": "string"
        },
        "title": "Overlay Refs",
        "type": "array"
      },
      "subtitle_refs": {
        "items": {
          "type": "string"
        },
        "title": "Subtitle Refs",
        "type": "array"
      },
      "hard_rule_refs": {
        "items": {
          "type": "string"
        },
        "title": "Hard Rule Refs",
        "type": "array"
      },
      "artistic_choices": {
        "items": {
          "type": "string"
        },

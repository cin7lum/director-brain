          "source_media_hash": {
            "title": "Source Media Hash",
            "type": "string"
          },
          "in_frame": {
            "title": "In Frame",
            "type": "integer"
          },
          "out_frame": {
            "title": "Out Frame",
            "type": "integer"
          },
          "timebase": {
            "title": "Timebase",
            "type": "integer"
          },
          "transition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Transition"
          },
          "effect_refs": {
            "items": {
              "type": "string"
            },
            "title": "Effect Refs",
            "type": "array"
          },
          "shot_function": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Shot Function"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rationale"
          },
          "act": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Act"
          },
          "evidence_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Evidence Type"
          }
        },
        "required": [
          "source_asset_id",
          "source_media_hash",
          "in_frame",
          "out_frame",
          "timebase"
        ],
        "title": "EditItem",
        "type": "object"
      }
    },
    "additionalProperties": false,

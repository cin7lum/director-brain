      },
      "project_id": {
        "title": "Project Id",
        "type": "string"
      },
      "created_at": {
        "title": "Created At",
        "type": "integer"
      },
      "producer": {
        "title": "Producer",
        "type": "string"
      },
      "source_ref": {
        "title": "Source Ref",
        "type": "string"
      },
      "edl_id": {
        "title": "Edl Id",
        "type": "string"
      },
      "version": {
        "title": "Version",
        "type": "string"
      },
      "brief_version": {
        "title": "Brief Version",
        "type": "string"
      },
      "context_id": {
        "title": "Context Id",
        "type": "string"
      },
      "source_asset_hashes": {
